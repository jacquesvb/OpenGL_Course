{
    "version": "2.0.0",
    "configurations":[
        {
            "name": "Run Application (Debug)",
            "type": "cppdbg",
            "MIMode": "gdb",
            "request": "launch",
            "program": "${workspaceFolder}/Build/bin/OpenGL_Course",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "${defaultBuildTask}",
            "externalConsole": false,
            "stopAtEntry": false,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for glm and std",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
